# DeliGo KCart Environment Variables
# Copy this file to .env.local and update with your values

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/deligo_kcart"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Payment Processing
# Use mock mode for development, live mode for production
PAYMENTS_LIVE=false

# Mock payment settings (for development)
MOCK_PAYMENT_DELAY_MS=3000
MOCK_FAILURE_RATE=0.05

# MTN Mobile Money Configuration
# Environment toggle: 'sandbox' for testing, 'production' for live
MTN_MOMO_ENVIRONMENT=sandbox

# Sandbox Credentials (for testing)
MTN_MOMO_SUBSCRIPTION_KEY_SANDBOX=your_sandbox_subscription_key
MTN_MOMO_API_USER_ID_SANDBOX=your_sandbox_api_user_id
MTN_MOMO_API_KEY_SANDBOX=your_sandbox_api_key
MTN_MOMO_BASE_URL_SANDBOX=https://sandbox.momodeveloper.mtn.com

# Production Credentials (for live)
MTN_MOMO_SUBSCRIPTION_KEY_PRODUCTION=your_production_subscription_key
MTN_MOMO_API_USER_ID_PRODUCTION=your_production_api_user_id
MTN_MOMO_API_KEY_PRODUCTION=your_production_api_key
MTN_MOMO_BASE_URL_PRODUCTION=https://proxy.momoapi.mtn.com

# Target Environment (auto-configured based on MTN_MOMO_ENVIRONMENT)
MTN_MOMO_TARGET_ENV=mtnrwanda

# Callback URL for payment notifications
MTN_MOMO_CALLBACK_URL=https://yourdomain.com/api/payments/mtn/webhook

# Airtel Money (for live mode)
AIRTEL_API_URL=https://developers.airtel.africa
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_API_SECRET=your_airtel_api_secret

# Platform Configuration
# Default commission rate (percentage)
PLATFORM_COMMISSION_RATE=0.15

# Admin receiver number for all payments (Rwanda format)
PLATFORM_PAYMENT_NUMBER=250788123456

# Payout mode: auto or manual
PAYOUT_MODE=manual

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Security
JWT_SECRET="your-super-secret-jwt-key-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# File Upload
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880  # 5MB in bytes

# Email Configuration (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@deligo.rw"

# Logging
LOG_LEVEL="info"
ENABLE_ADMIN_LOGS=true

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn-here
ENABLE_SENTRY=false

# Development Only
ENABLE_DEBUG_LOGS=true
ENABLE_MOCK_PAYMENTS=true